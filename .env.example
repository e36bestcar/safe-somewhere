# Public site URL (no trailing slash). Used for metadataBase, canonical, sitemap.
# On Vercel, VERCEL_URL is used as a fallback when this is unset.
NEXT_PUBLIC_SITE_URL=https://www.safesomewhere.com

# No server secrets required for v1 (static landing).
# When Payload/CMS lands, put DATABASE_URL and PAYLOAD_SECRET here — never commit.
