{
  "name": "safe-somewhere",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3031",
    "build": "next build",
    "start": "next start -p 3031",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:visual-lock": "node scripts/verify-visual-lock.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm run verify:visual-lock && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
